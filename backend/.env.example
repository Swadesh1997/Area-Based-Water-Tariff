# Copy to backend/.env. Never commit the real file.
PORT=3000
NODE_ENV=development

# "mysql" (default) or "postgres"
DATABASE_TYPE=postgres

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=water_tariff

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=water_tariff
